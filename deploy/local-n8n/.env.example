# Copy to .env (scripts/install.sh does this and fills the key for you).
# Never commit .env: the encryption key protects every saved credential.
N8N_ENCRYPTION_KEY=
N8N_VERSION=latest
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# Only needed for scripts/export-from-cloud.sh (one-time migration).
# Cloud UI -> Settings -> n8n API -> Create API key.
N8N_CLOUD_URL=https://YOUR-INSTANCE.app.n8n.cloud
N8N_CLOUD_API_KEY=
